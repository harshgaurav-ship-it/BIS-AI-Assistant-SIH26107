# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Virtual environments and local tooling
.venv/
venv/
env/
.env
.env.*
!.env.example

# Streamlit secrets and local settings
.streamlit/secrets.toml

# Local data and generated RAG artifacts
